---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-10 border-b border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-950 relative">
  <div class="mx-auto flex h-14 w-full max-w-3xl items-center justify-between px-6">
    <a
      href="/"
      class="font-display text-xl text-neutral-900 dark:text-white"
      aria-label={`${site.username} — home`}
    >
      {site.username}
    </a>

    <div class="flex items-center gap-5 font-mono text-[13px]">
      <nav aria-label="Main" class="hidden items-center gap-5 font-sans sm:flex">
        {
          site.nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'hover:text-neutral-900 dark:hover:text-white',
                isActive(item.href)
                  ? 'text-neutral-900 dark:text-white'
                  : 'text-neutral-500 dark:text-neutral-400',
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <ThemeToggle />

      <button
        type="button"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label="Open menu"
        class="sm:hidden text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white"
      >
        <span class="nav-icon-open" aria-hidden="true">☰</span>
        <span class="nav-icon-close hidden" aria-hidden="true">✕</span>
      </button>
    </div>
  </div>

  <div id="nav-menu" class="hidden absolute inset-x-0 top-full z-10 px-3 pt-2 pb-3 sm:hidden">
    <nav
      aria-label="Main"
      class="nav-panel mx-auto w-full max-w-3xl rounded-xl border border-neutral-200/70 bg-white/60 p-2 font-sans text-[13px] shadow-lg shadow-neutral-900/5 backdrop-blur-xl backdrop-saturate-150 dark:border-white/10 dark:bg-neutral-900/50 dark:shadow-black/40"
    >
      <ul>
        {
          site.nav.map((item, index) => (
            <li class="nav-item" style={`--index: ${index}`}>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'relative block rounded-lg px-3 py-2.5 transition-colors hover:bg-neutral-900/5 dark:hover:bg-white/5',
                  'before:absolute before:inset-y-2 before:left-0 before:w-0.5 before:rounded-full before:bg-neutral-900 before:opacity-0 before:transition-opacity dark:before:bg-white',
                  isActive(item.href)
                    ? 'bg-neutral-900/5 text-neutral-900 before:opacity-100 dark:bg-white/5 dark:text-white'
                    : 'text-neutral-500 dark:text-neutral-400',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .nav-panel {
      animation: nav-panel-in 160ms ease-out both;
    }

    .nav-item {
      animation: nav-item-in 200ms ease-out both;
      animation-delay: calc(var(--index) * 25ms);
    }
  }

  @keyframes nav-panel-in {
    from {
      opacity: 0;
      translate: 0 -4px;
    }
  }

  @keyframes nav-item-in {
    from {
      opacity: 0;
      translate: 0 -3px;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');

  function setOpen(open: boolean) {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    toggle?.querySelector('.nav-icon-open')?.classList.toggle('hidden', open);
    toggle?.querySelector('.nav-icon-close')?.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  // Close when a link is followed or Escape is pressed.
  menu?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) setOpen(false);
  });

  // Close when tapping the frosted panel's inset gutter (outside the nav surface).
  menu?.addEventListener('pointerdown', (event) => {
    if ((event.target as Element).closest('nav')) return;
    setOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });

  // Reset on resize so the menu doesn't stay open (or hidden) across breakpoints.
  window.matchMedia('(min-width: 40rem)').addEventListener('change', () => setOpen(false));
</script>

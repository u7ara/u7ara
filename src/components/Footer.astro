---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-neutral-200 dark:border-neutral-800">
  <div
    class="mx-auto flex w-full max-w-3xl flex-col gap-2 px-6 py-8 text-[13px] text-neutral-500 dark:text-neutral-400 sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {year} u7ara</p>

    <ul class="flex items-center gap-5">
      {
        site.socials.map((social) => (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="link-muted"
            >
              {social.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

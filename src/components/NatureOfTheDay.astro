---
import { Image } from 'astro:assets';
import Section from './Section.astro';

/**
 * "Nature of the day" — a single featured photo.
 * Drop any image into src/assets/photography/ to show it; the section hides
 * itself when the folder is empty. The newest file (by name) wins, so
 * date-prefixed filenames like 2026-10-21.jpg cycle naturally.
 * Clicking the photo opens it enlarged in a modal <dialog>.
 */
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/photography/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const latest = Object.keys(images)
  .sort()
  .pop();
const image = latest ? images[latest].default : undefined;
---

{
  image && (
    <Section title="Nature of the day">
      <figure>
        <button
          type="button"
          class="block w-full cursor-zoom-in"
          aria-label="Enlarge photo"
          data-lightbox-open
        >
          <Image
            src={image}
            alt="Today Image."
            widths={[600, 900]}
            sizes="(min-width: 768px) 720px, 100vw"
            class="w-full outline p-2 outline-neutral-500 hover:outline-neutral-200 object-cover dark:border-neutral-800"
          />
        </button>
      </figure>

      <dialog
        data-lightbox
        aria-label="Enlarged photo"
        class="m-auto h-[80dvh] w-[min(92vw,1000px)] max-w-none bg-transparent p-0 outline-none backdrop:bg-neutral-950/80 backdrop:backdrop-blur-sm open:flex open:items-center open:justify-center"
      >
        <Image
          src={image}
          alt="Today Image."
          widths={[900, 1400, 1920]}
          sizes="100vw"
          class="h-full w-full object-contain"
        />
      </dialog>
    </Section>
  )
}

<script>
  const trigger = document.querySelector<HTMLButtonElement>('[data-lightbox-open]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');

  trigger?.addEventListener('click', () => dialog?.showModal());

  // Close when tapping outside the photo. The blurred area is the dialog's
  // ::backdrop pseudo-element, which doesn't deliver clicks, and the image is
  // object-contain so its element box is larger than the visible photo. We
  // therefore compare the tap against the image's *rendered* box and only close
  // when the tap misses it — so a tap on the photo itself does nothing.
  const image = dialog?.querySelector<HTMLImageElement>('img');

  function renderedImageRect(img: HTMLImageElement) {
    const box = img.getBoundingClientRect();
    if (!img.naturalWidth || !img.naturalHeight) return box;

    // object-contain: fit the natural aspect ratio inside the element box.
    const scale = Math.min(box.width / img.naturalWidth, box.height / img.naturalHeight);
    const width = img.naturalWidth * scale;
    const height = img.naturalHeight * scale;

    return {
      left: box.left + (box.width - width) / 2,
      top: box.top + (box.height - height) / 2,
      right: box.left + (box.width + width) / 2,
      bottom: box.top + (box.height + height) / 2,
    };
  }

  dialog?.addEventListener('click', (event) => {
    if (!image) return;
    const rect = renderedImageRect(image);
    const { clientX: x, clientY: y } = event;
    const insideImage = x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom;
    if (!insideImage) dialog.close();
  });
</script>

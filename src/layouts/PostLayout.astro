---
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/Prose.astro';
import type { Post } from '../lib/posts';
import { formatPostDate } from '../lib/posts';

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
}

const { post, prev, next } = Astro.props;
---

<BaseLayout title={post.title} description={post.description}>
  <article class="pt-16 sm:pt-24">
    <header>
      <h1 class="text-3xl sm:text-[38px] sm:leading-tight">{post.title}</h1>
      <p class="mt-3 text-[13px] text-neutral-500 dark:text-neutral-400">
        <time datetime={post.date.toISOString()}>{formatPostDate(post.date)}</time>
        · {post.minutes} min read
      </p>
      <p class="mt-6 max-w-[65ch] text-neutral-500 dark:text-neutral-400">{post.description}</p>
      <hr class="mt-10 border-neutral-200 dark:border-neutral-800" />
    </header>

    <div class="mt-10">
      <Prose>
        <slot />
      </Prose>
    </div>

    <nav
      aria-label="More posts"
      class="mt-16 grid gap-6 border-t border-neutral-200 pt-8 text-[13px] dark:border-neutral-800 sm:grid-cols-2"
    >
      {
        prev ? (
          <a href={`/blog/${prev.slug}`} class="group flex flex-col gap-1">
            <span class="text-neutral-500 dark:text-neutral-400">← Previous</span>
            <span class="text-neutral-900 group-hover:underline group-hover:underline-offset-4 dark:text-white">
              {prev.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/blog/${next.slug}`} class="group flex flex-col gap-1 sm:items-end sm:text-right">
            <span class="text-neutral-500 dark:text-neutral-400">Next →</span>
            <span class="text-neutral-900 group-hover:underline group-hover:underline-offset-4 dark:text-white">
              {next.title}
            </span>
          </a>
        )
      }
    </nav>

    <p class="mt-10 text-[13px]">
      <a href="/blog" class="link-muted">← All posts</a>
    </p>
  </article>

  <dialog
    data-lightbox
    aria-label="Enlarged image"
    class="m-auto h-[80dvh] w-[min(92vw,1000px)] max-w-none bg-transparent p-0 outline-none backdrop:bg-neutral-950/80 backdrop:backdrop-blur-sm"
  >
    <img alt="" class="h-full w-full object-contain" />
  </dialog>

  <script>
    // Make images in rendered post Markdown clickable. They arrive as plain
    // <img> tags from Markdown, so they are upgraded here at runtime.
    const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    const preview = dialog?.querySelector('img');
    const images = document.querySelectorAll<HTMLImageElement>('.prose img');

    images.forEach((image) => {
      image.classList.add('cursor-zoom-in');
      image.addEventListener('click', () => {
        if (!dialog || !preview) return;
        preview.src = image.currentSrc || image.src;
        preview.alt = image.alt;
        dialog.showModal();
      });
    });

    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    // Reset when closed so the previous photo isn't shown on the next open.
    dialog?.addEventListener('close', () => {
      if (preview) preview.removeAttribute('src');
    });
  </script>
</BaseLayout>

---
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/Prose.astro';
import type { Post } from '../lib/posts';
import { formatPostDate } from '../lib/posts';

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
}

const { post, prev, next } = Astro.props;
---

<BaseLayout title={post.title} description={post.description}>
  <article class="pt-16 sm:pt-24">
    <header>
      <h1 class="font-display text-4xl leading-tight sm:text-5xl">{post.title}</h1>
      <p class="meta mt-3">
        <time datetime={post.date.toISOString()}>{formatPostDate(post.date)}</time>
        · {post.minutes} min read
      </p>
      <p class="mt-6 max-w-[65ch] text-neutral-500 dark:text-neutral-400">{post.description}</p>
      <hr class="mt-10 border-neutral-200 dark:border-neutral-800" />
    </header>

    <div class="mt-10">
      <Prose>
        <slot />
      </Prose>
    </div>

    <nav
      aria-label="More posts"
      class="mt-16 grid gap-6 border-t border-neutral-200 pt-8 dark:border-neutral-800 sm:grid-cols-2"
    >
      {
        prev ? (
          <a href={`/blog/${prev.slug}`} class="group flex flex-col gap-1">
            <span class="label">← Previous</span>
            <span class="font-display text-lg text-neutral-900 group-hover:underline group-hover:underline-offset-4 dark:text-white">
              {prev.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/blog/${next.slug}`} class="group flex flex-col gap-1 sm:items-end sm:text-right">
            <span class="label">Next →</span>
            <span class="font-display text-lg text-neutral-900 group-hover:underline group-hover:underline-offset-4 dark:text-white">
              {next.title}
            </span>
          </a>
        )
      }
    </nav>

    <p class="mt-10 font-mono text-[13px]">
      <a href="/blog" class="link-muted">← All posts</a>
    </p>
  </article>

  <dialog
    data-lightbox
    aria-label="Enlarged image"
    class="m-auto h-[80dvh] w-[min(92vw,1000px)] max-w-none bg-transparent p-0 outline-none backdrop:bg-neutral-950/80 backdrop:backdrop-blur-sm"
  >
    <img alt="" class="h-full w-full object-contain" />
  </dialog>

  <script>
    // Make images in rendered post Markdown clickable. They arrive as plain
    // <img> tags from Markdown, so they are upgraded here at runtime.
    const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    const preview = dialog?.querySelector('img');
    const images = document.querySelectorAll<HTMLImageElement>('.prose img');

    images.forEach((image) => {
      image.classList.add('cursor-zoom-in');
      image.addEventListener('click', () => {
        if (!dialog || !preview) return;
        preview.src = image.currentSrc || image.src;
        preview.alt = image.alt;
        dialog.showModal();
      });
    });

    // Close when tapping outside the photo. The blurred area is the dialog's
    // ::backdrop pseudo-element, which doesn't deliver clicks, and the image is
    // object-contain so its element box is larger than the visible photo. We
    // therefore compare the tap against the image's *rendered* box and only
    // close when the tap misses it — so a tap on the photo itself does nothing.
    function renderedImageRect(img: HTMLImageElement) {
      const box = img.getBoundingClientRect();
      if (!img.naturalWidth || !img.naturalHeight) return box;

      const scale = Math.min(box.width / img.naturalWidth, box.height / img.naturalHeight);
      const width = img.naturalWidth * scale;
      const height = img.naturalHeight * scale;

      return {
        left: box.left + (box.width - width) / 2,
        top: box.top + (box.height - height) / 2,
        right: box.left + (box.width + width) / 2,
        bottom: box.top + (box.height + height) / 2,
      };
    }

    dialog?.addEventListener('click', (event) => {
      if (!preview) return;
      const rect = renderedImageRect(preview);
      const { clientX: x, clientY: y } = event;
      const insideImage = x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom;
      if (!insideImage) dialog.close();
    });

    // Reset when closed so the previous photo isn't shown on the next open.
    dialog?.addEventListener('close', () => {
      if (preview) preview.removeAttribute('src');
    });
  </script>
</BaseLayout>

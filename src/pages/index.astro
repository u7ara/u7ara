---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PostRow from '../components/PostRow.astro';
import NatureOfTheDay  from '../components/NatureOfTheDay.astro';
import { site } from '../data/site';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 3);
---

<BaseLayout>
  <section class="pt-16 sm:pt-24">
    <h1 class="text-3xl sm:text-[38px] sm:leading-tight">
      Hey, I'm {site.name}.
    </h1>
    <p class="mt-3 text-xl text-neutral-500 dark:text-neutral-400">
      {site.title} in {site.location}.
    </p>

    <p class="mt-6 max-w-[65ch]">
      i explore numbers, took patterns and write about the parts worth remembering.
      this is where i keep notes on finance, films, and whatever else i'm turning over.
    </p>

    <p class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-[13px]">
      <a href="/blog" class="link">Read the blog</a>
      <a href="/cv" class="link">View CV</a>
    </p>
  </section>

  <Section title="Recent writing">
    <a slot="aside" href="/blog" class="link-muted">All posts →</a>
    <PostRow posts={posts} />
  </Section>

  <NatureOfTheDay/>
</BaseLayout>
